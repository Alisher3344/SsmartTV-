# Database (async driver)
DATABASE_URL=postgresql+asyncpg://ssmart:ssmart@localhost:5432/ssmarttv

# Redis (session store)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
SESSION_COOKIE_NAME=ssmart_session
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_SECURE=false

# CORS — Vite dev server origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow any localhost port in dev (Vite may switch to 5174, 5175, ...).
# Leave empty to restrict to CORS_ORIGINS only.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+
