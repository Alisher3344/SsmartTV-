# Environment: development | test | production
ENVIRONMENT=development

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://ssmart:ssmart@localhost:5432/ssmarttv
REDIS_URL=redis://localhost:6379/0

# --- Security / sessions ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
SESSION_COOKIE_NAME=ssmart_session
SESSION_TTL_SECONDS=5184000          # 60 days (phone/OTP users)
STAFF_SESSION_TTL_SECONDS=604800     # 7 days (password staff/admin)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- SMS provider (eskiz.uz) ---
# console = print codes to stdout (dev); eskiz = send real SMS
SMS_BACKEND=console
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Streaming / SSRF ---
# Extra upstream hosts the HLS proxy may fetch (comma-separated). Channel
# stream hosts in the DB are always allowed.
STREAM_ALLOWED_HOSTS=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
